[Unit]
Description=CariTranscoder Mux Service - %i
Documentation=https://github.com/caritechsolutions/caritranscoder
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Configuration
Environment="CONFIG_DIR=/etc/caritrans"
Environment="RUN_DIR=/run/caritrans"
Environment="LOG_DIR=/var/log/caritrans"
# TSDuck path
Environment="PATH=/usr/bin:/usr/local/bin:/opt/tsduck/bin"

# Main process - cari-mux reads config and forks tsp
ExecStart=/usr/local/bin/cari-mux --config ${CONFIG_DIR}/muxers/%i.conf
ExecReload=/bin/kill -HUP $MAINPID

# Restart behavior
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cari-mux-%i

[Install]
WantedBy=multi-user.target
